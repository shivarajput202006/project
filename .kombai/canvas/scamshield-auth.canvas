      "contentHeight": 1000
    },
    "var_46b6c5811cb5": {
      "type": "variant",
      "label": "Sign in — status board",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4140,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n*, *::before, *::after { box-sizing: border-box; }\nbody { margin: 0; }\n\n.page {\n  min-height: 100vh; display: flex; flex-direction: column;\n  font-family: \"DM Sans\", sans-serif; color: #f8fafc;\n  background: radial-gradient(ellipse at 50% -14%, rgba(37,99,235,.13), transparent 46%), #080d1b;\n}\n.masthead { display: flex; align-items: center; justify-content: space-between; height: 64px; padding: 0 40px; border-bottom: 1px solid rgba(148,163,184,.14); }\n.brand { display: inline-flex; align-items: center; gap: 9px; font-family: Manrope, sans-serif; font-size: 15.5px; font-weight: 800; letter-spacing: -.6px; color: #f8fafc; text-decoration: none; }\n.brand em { font-style: normal; color: #67d8ed; }\n.brand img { display: block; width: 26px; height: 26px; }\n.back-link { display: inline-flex; align-items: center; gap: 7px; color: #a4b0c2; font-size: 11px; text-decoration: none; }\n.back-link:hover { color: #fff; }\n.back-link i { font-size: 13px; }\n\n.wrap { flex: 1; display: grid; grid-template-columns: 292px minmax(0,1fr); gap: 16px; align-items: start; align-content: center; width: min(1180px, 100% - 72px); margin: 0 auto; padding: 30px 0; }\n\n.plate { position: relative; border: 1px solid rgba(148,163,184,.22); border-radius: 2px 10px 2px 10px; background: linear-gradient(178deg, #111a2c, #0c1524);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,.055), 0 2px 0 rgba(0,0,0,.55);\n}\n.plate::before { content: \"\"; position: absolute; inset: 3px; border: 1px solid rgba(148,163,184,.1); border-radius: 1px 7px 1px 7px; pointer-events: none; }\n\n.access-head { display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; border-bottom: 1px solid rgba(148,163,184,.14); }\n.access-head span { font-size: 9.5px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase; color: #8395ab; }\n.access-head i { font-size: 13px; color: #4fbfd4; }\n\n.access ul { margin: 0; padding: 0; list-style: none; }\n.access li { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 10px; height: 44px; padding: 0 16px 0 22px; border-bottom: 1px solid rgba(148,163,184,.09); }\n.access li:last-child { border-bottom: 0; }\n.access li::before { content: \"\"; position: absolute; left: 8px; top: 10px; bottom: 10px; width: 6px;\n  background: repeating-linear-gradient(180deg, rgba(148,163,184,.42) 0 1px, transparent 1px 4px); }\n.access .nm { color: #d5dfeb; font-size: 11.5px; font-weight: 500; }\n.access .st { color: #7d8da3; font-size: 9.5px; white-space: nowrap; }\n.access .foot { padding: 12px 16px; border-top: 1px solid rgba(148,163,184,.14); color: #75849a; font-size: 9.5px; line-height: 1.6; }\n\n.board { position: relative; border: 1px solid rgba(148,163,184,.22); border-radius: 10px 2px 10px 2px; background: linear-gradient(178deg, #111a2c, #0b1423);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,.055), 0 2px 0 rgba(0,0,0,.55); overflow: hidden;\n}\n.board::after { content: \"\"; position: absolute; top: 0; right: 0; width: 14px; height: 14px;\n  background: linear-gradient(225deg, #080d1b 50%, transparent 50%); }\n.board-top { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; padding: 20px 22px 16px; border-bottom: 1px solid rgba(148,163,184,.16); }\n.board-top h1 { margin: 0; font-family: Manrope, sans-serif; font-size: 26px; font-weight: 800; letter-spacing: -1px; line-height: 1; }\n.board-top .meta { display: flex; align-items: center; gap: 8px; color: #8290a5; font-size: 10px; }\n.board-top .dot { width: 6px; height: 6px; border-radius: 50%; background: #4fbfd4; box-shadow: 0 0 10px rgba(34,211,238,.7); }\n\n.cols { display: grid; grid-template-columns: minmax(0,1fr) 218px 100px 24px; gap: 14px; padding: 0 22px; height: 30px; align-items: center; border-bottom: 1px solid rgba(148,163,184,.14); }\n.cols span { font-size: 9px; font-weight: 700; letter-spacing: 1.1px; text-transform: uppercase; color: #6f8096; }\n\n.row { display: grid; grid-template-columns: minmax(0,1fr) 218px 100px 24px; gap: 14px; align-items: center; width: 100%; height: 52px; padding: 0 22px;\n  border: 0; border-bottom: 1px solid rgba(148,163,184,.09); background: none; color: #e6edf6;\n  font-family: inherit; font-size: 12px; font-weight: 600; text-align: left; cursor: pointer;\n  transition: background .16s ease;\n}\n.row:hover { background: rgba(6,182,212,.055); }\n.row .m-name { display: flex; align-items: center; gap: 10px; }\n.row .mark { display: grid; place-items: center; width: 20px; height: 20px; color: #9fb0c6; }\n.row .mark svg { width: 15px; height: 15px; display: block; }\n.row .mark i { font-size: 15px; }\n.row .returns { color: #8395ab; font-size: 10.5px; font-weight: 500; }\n.row .state { justify-self: start; padding: 3px 8px; border: 1px solid rgba(148,163,184,.22); border-radius: 2px; background: rgba(148,163,184,.07); color: #93a3b7; font-size: 9px; font-weight: 700; letter-spacing: .5px; }\n.row .chev { justify-self: end; color: #64748b; font-size: 15px; }\n.row:hover .chev { color: #6fdcec; }\n\n.row.is-open { background: linear-gradient(90deg, rgba(6,182,212,.09), rgba(6,182,212,0)); border-bottom: 0; }\n.row.is-open .state { border-color: rgba(34,211,238,.45); background: rgba(6,182,212,.14); color: #8fe3f0; }\n.row.is-open .chev { color: #7fe4f2; }\n\n.body { padding: 4px 22px 20px; border-bottom: 1px solid rgba(148,163,184,.09); background: linear-gradient(180deg, rgba(6,182,212,.045), transparent 60%); }\n.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\n.f-label { display: block; margin-bottom: 6px; color: #a9b7c9; font-size: 9.5px; font-weight: 700; letter-spacing: .6px; text-transform: uppercase; }\n.well { display: flex; align-items: center; gap: 8px; height: 40px; padding: 0 11px; border: 1px solid rgba(148,163,184,.26); border-radius: 2px;\n  background: #05090f; color: #78879c; box-shadow: inset 0 2px 5px rgba(0,0,0,.85);\n  transition: border-color .18s ease, box-shadow .18s ease;\n}\n.well:focus-within { border-color: rgba(34,211,238,.72); box-shadow: inset 0 2px 5px rgba(0,0,0,.85), 0 1px 0 rgba(34,211,238,.55); }\n.well i { font-size: 14px; }\n.well input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; color: #f1f5f9; font-family: inherit; font-size: 11.5px; }\n.well input::placeholder { color: #5d6c83; }\n.ptoggle { display: grid; place-items: center; border: 0; padding: 3px; background: none; color: #7e8da3; font-size: 14px; cursor: pointer; }\n.ptoggle:hover { color: #d7e3f2; }\n\n.actions { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 14px; }\n.check { display: inline-flex; align-items: center; gap: 7px; color: #a2b0c3; font-size: 10.5px; cursor: pointer; }\n.check input { position: absolute; opacity: 0; pointer-events: none; }\n.check .box { display: grid; place-items: center; width: 13px; height: 13px; border-radius: 2px; border: 1px solid rgba(148,163,184,.4); background: #05090f; color: transparent; font-size: 8px; transition: .16s ease; }\n.check input:checked + .box { border-color: rgba(34,211,238,.8); background: rgba(6,182,212,.22); color: #a5f3fc; }\n.actions .left { display: inline-flex; align-items: center; gap: 18px; }\n.f-link { color: #6bcfe0; font-size: 10px; font-weight: 600; text-decoration: none; }\n.f-link:hover { color: #a1e5ef; }\n\n.submit { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-width: 168px; height: 40px; padding: 0 20px;\n  border: 1px solid rgba(96,165,250,.55); border-radius: 2px; background: #2563eb; color: #fff;\n  font-family: inherit; font-size: 11.5px; font-weight: 700; letter-spacing: .3px; cursor: pointer;\n  box-shadow: 3px 3px 0 rgba(0,0,0,.7), inset 0 1px 0 rgba(255,255,255,.2);\n  transition: transform .16s ease, box-shadow .16s ease, background .16s ease;\n}\n.submit:hover { background: #2f6ff5; transform: translate(-1px,-1px); box-shadow: 4px 4px 0 rgba(0,0,0,.7), inset 0 1px 0 rgba(255,255,255,.24); }\n.submit i { font-size: 14px; }\n\n.foot-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 22px; background: rgba(5,11,22,.4); }\n.foot-row span { color: #8395ab; font-size: 10.5px; }\n.foot-row a { color: #6bcfe0; font-size: 10.5px; font-weight: 600; text-decoration: none; }\n.foot-row a:hover { color: #a1e5ef; }\n\n.page-foot { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 14px 40px; border-top: 1px solid rgba(148,163,184,.11); color: #6f7f95; font-size: 9.5px; }\n.page-foot nav { display: flex; gap: 18px; }\n.page-foot nav a { color: #7f8ea5; text-decoration: none; }\n.page-foot nav a:hover { color: #d6e5f6; }\n\n@media (max-width: 1020px) {\n  .wrap { grid-template-columns: 1fr; width: min(720px, calc(100% - 40px)); padding: 22px 0; }\n  .access { order: 2; }\n  .board { order: 1; }\n}\n@media (max-width: 700px) {\n  .masthead { padding: 0 18px; }\n  .board-top { flex-direction: column; align-items: flex-start; gap: 10px; padding: 18px 16px 14px; }\n  .cols { display: none; }\n  .row { grid-template-columns: minmax(0,1fr) 84px 20px; height: auto; min-height: 52px; padding: 10px 16px; gap: 10px; }\n  .row .returns { display: none; }\n  .grid2 { grid-template-columns: 1fr; }\n  .body { padding: 4px 16px 18px; }\n  .actions { flex-direction: column; align-items: stretch; gap: 12px; }\n  .actions .left { justify-content: space-between; }\n  .submit { width: 100%; }\n  .foot-row { padding: 14px 16px; }\n  .page-foot { flex-direction: column; gap: 8px; align-items: flex-start; padding: 14px 18px; }\n}\n</style>\n<main class=\"page\" data-kid=\"1\" data-name=\"page layout container\">\n<header class=\"masthead\" data-kid=\"1-1\" data-name=\"masthead navigation bar\">\n<a class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"#\"><img alt=\"\" data-kid=\"1-1-1-1\" data-name=\"brand shield logo image\" height=\"26\" src=\"/api/local/images/ScamShield-AI/frontend/public/shield.svg\" width=\"26\"/><span data-kid=\"1-1-1-2\" data-name=\"brand name text\">ScamShield<em data-kid=\"1-1-1-2-1\" data-name=\"brand AI accent text\"> AI</em></span></a>\n<a class=\"back-link\" data-kid=\"1-1-2\" data-name=\"back to home link\" href=\"#\"><i aria-hidden=\"true\" class=\"icon-arrow-left\" data-kid=\"1-1-2-1\" data-name=\"left arrow icon\"></i>Back to home</a>\n</header>\n<section class=\"wrap\" data-kid=\"1-2\" data-name=\"main content grid\">\n<aside class=\"plate access\" data-kid=\"1-2-1\" data-name=\"workspace access sidebar panel\">\n<div class=\"access-head\" data-kid=\"1-2-1-1\" data-name=\"access panel header\"><span data-kid=\"1-2-1-1-1\" data-name=\"access panel title label\">Workspace access</span><i aria-hidden=\"true\" class=\"icon-lock-keyhole\" data-kid=\"1-2-1-1-2\" data-name=\"lock keyhole icon\"></i></div>\n<ul data-kid=\"1-2-1-2\" data-name=\"access item list\">\n<li data-kid=\"1-2-1-2-1\" data-name=\"access item row (scam detection)\"><span class=\"nm\" data-kid=\"1-2-1-2-1-1\" data-name=\"access item name\">Scam detection</span><span class=\"st\" data-kid=\"1-2-1-2-1-2\" data-name=\"access item status text\">Sign in required</span></li>\n<li data-kid=\"1-2-1-2-2\" data-name=\"access item row (URL scanner)\"><span class=\"nm\" data-kid=\"1-2-1-2-2-1\" data-name=\"access item name\">URL scanner</span><span class=\"st\" data-kid=\"1-2-1-2-2-2\" data-name=\"access item status text\">Sign in required</span></li>\n<li data-kid=\"1-2-1-2-3\" data-name=\"access item row (resume analyzer)\"><span class=\"nm\" data-kid=\"1-2-1-2-3-1\" data-name=\"access item name\">Resume analyzer</span><span class=\"st\" data-kid=\"1-2-1-2-3-2\" data-name=\"access item status text\">Sign in required</span></li>\n<li data-kid=\"1-2-1-2-4\" data-name=\"access item row (job finder)\"><span class=\"nm\" data-kid=\"1-2-1-2-4-1\" data-name=\"access item name\">Job finder</span><span class=\"st\" data-kid=\"1-2-1-2-4-2\" data-name=\"access item status text\">Sign in required</span></li>\n</ul>\n<div class=\"foot\" data-kid=\"1-2-1-3\" data-name=\"access panel security note text\">Session cookies are HttpOnly and CSRF-protected.</div>\n</aside>\n<section class=\"board\" data-kid=\"1-2-2\" data-name=\"sign-in board panel\">\n<div class=\"board-top\" data-kid=\"1-2-2-1\" data-name=\"board header bar\">\n<h1 data-kid=\"1-2-2-1-1\" data-name=\"board title heading\">Sign in</h1>\n<div class=\"meta\" data-kid=\"1-2-2-1-2\" data-name=\"board meta info row\"><span aria-hidden=\"true\" class=\"dot\" data-kid=\"1-2-2-1-2-1\" data-name=\"meta status dot\"></span>3 methods available</div>\n</div>\n<div class=\"cols\" data-kid=\"1-2-2-2\" data-name=\"column header row\"><span data-kid=\"1-2-2-2-1\" data-name=\"method column header\">Method</span><span data-kid=\"1-2-2-2-2\" data-name=\"returns column header\">Returns</span><span data-kid=\"1-2-2-2-3\" data-name=\"state column header\">State</span><span data-kid=\"1-2-2-2-4\" data-name=\"empty column header spacer\"></span></div>\n<button class=\"row\" data-kid=\"1-2-2-3\" data-name=\"GitHub sign-in method button\" type=\"button\">\n<span class=\"m-name\" data-kid=\"1-2-2-3-1\" data-name=\"GitHub method name row\"><span class=\"mark\" data-kid=\"1-2-2-3-1-1\" data-name=\"GitHub logo icon container\"><svg aria-hidden=\"true\" data-kid=\"1-2-2-3-1-1-1\" data-name=\"GitHub logo SVG icon\" viewbox=\"0 0 24 24\"><path d=\"M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12\" fill=\"#e8eef8\"></path></svg></span>GitHub</span>\n<span class=\"returns\" data-kid=\"1-2-2-3-2\" data-name=\"GitHub method returns description\">Public profile, primary email</span>\n<span class=\"state\" data-kid=\"1-2-2-3-3\" data-name=\"GitHub method state badge\">Ready</span>\n<i aria-hidden=\"true\" class=\"icon-chevron-right chev\" data-kid=\"1-2-2-3-4\" data-name=\"chevron right icon\"></i>\n</button>\n<button class=\"row\" data-kid=\"1-2-2-4\" data-name=\"LinkedIn sign-in method button\" type=\"button\">\n<span class=\"m-name\" data-kid=\"1-2-2-4-1\" data-name=\"LinkedIn method name row\"><span class=\"mark\" data-kid=\"1-2-2-4-1-1\" data-name=\"LinkedIn logo icon container\"><svg aria-hidden=\"true\" data-kid=\"1-2-2-4-1-1-1\" data-name=\"LinkedIn logo SVG icon\" viewbox=\"0 0 24 24\"><path d=\"M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z\" fill=\"#5aa9ef\"></path></svg></span>LinkedIn</span>\n<span class=\"returns\" data-kid=\"1-2-2-4-2\" data-name=\"LinkedIn method returns description\">Name, verified email</span>\n<span class=\"state\" data-kid=\"1-2-2-4-3\" data-name=\"LinkedIn method state badge\">Ready</span>\n<i aria-hidden=\"true\" class=\"icon-chevron-right chev\" data-kid=\"1-2-2-4-4\" data-name=\"chevron right icon\"></i>\n</button>\n<div class=\"row is-open\" data-kid=\"1-2-2-5\" data-name=\"email password method row (open)\">\n<span class=\"m-name\" data-kid=\"1-2-2-5-1\" data-name=\"email method name row\"><span class=\"mark\" data-kid=\"1-2-2-5-1-1\" data-name=\"email icon container\"><i aria-hidden=\"true\" class=\"icon-mail\" data-kid=\"1-2-2-5-1-1-1\" data-name=\"mail icon\"></i></span>Email and password</span>\n<span class=\"returns\" data-kid=\"1-2-2-5-2\" data-name=\"email method returns description\">Password sign-in</span>\n<span class=\"state\" data-kid=\"1-2-2-5-3\" data-name=\"email method state badge\">Open</span>\n<i aria-hidden=\"true\" class=\"icon-chevron-up chev\" data-kid=\"1-2-2-5-4\" data-name=\"chevron up icon\"></i>\n</div>\n<div class=\"body\" data-kid=\"1-2-2-6\" data-name=\"sign-in form body panel\">\n<div class=\"grid2\" data-kid=\"1-2-2-6-1\" data-name=\"form fields grid\">\n<div data-kid=\"1-2-2-6-1-1\" data-name=\"email field column wrapper\">\n<label class=\"f-label\" data-kid=\"1-2-2-6-1-1-1\" data-name=\"email field label\" for=\"c-email\">Email address</label>\n<div class=\"well\" data-kid=\"1-2-2-6-1-1-2\" data-name=\"email input well\">\n<i aria-hidden=\"true\" class=\"icon-mail\" data-kid=\"1-2-2-6-1-1-2-1\" data-name=\"email field icon\"></i>\n<input autocomplete=\"email\" data-kid=\"1-2-2-6-1-1-2-2\" data-name=\"email input field\" id=\"c-email\" name=\"email\" placeholder=\"you@example.com\" type=\"email\"/>\n</div>\n</div>\n<div data-kid=\"1-2-2-6-1-2\" data-name=\"password field column wrapper\">\n<label class=\"f-label\" data-kid=\"1-2-2-6-1-2-1\" data-name=\"password field label\" for=\"c-password\">Password</label>\n<div class=\"well\" data-kid=\"1-2-2-6-1-2-2\" data-name=\"password input well\">\n<i aria-hidden=\"true\" class=\"icon-lock-keyhole\" data-kid=\"1-2-2-6-1-2-2-1\" data-name=\"password field lock icon\"></i>\n<input autocomplete=\"current-password\" data-kid=\"1-2-2-6-1-2-2-2\" data-name=\"password input field\" id=\"c-password\" name=\"password\" placeholder=\"Enter your password\" type=\"password\"/>\n<button aria-label=\"Show password\" class=\"ptoggle\" data-kid=\"1-2-2-6-1-2-2-3\" data-name=\"show password toggle button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-eye\" data-kid=\"1-2-2-6-1-2-2-3-1\" data-name=\"eye icon\"></i></button>\n</div>\n</div>\n</div>\n<div class=\"actions\" data-kid=\"1-2-2-6-2\" data-name=\"form actions row\">\n<div class=\"left\" data-kid=\"1-2-2-6-2-1\" data-name=\"actions left group\">\n<label class=\"check\" data-kid=\"1-2-2-6-2-1-1\" data-name=\"remember me checkbox label\">\n<input checked=\"\" data-kid=\"1-2-2-6-2-1-1-1\" data-name=\"remember me hidden checkbox\" type=\"checkbox\"/>\n<span class=\"box\" data-kid=\"1-2-2-6-2-1-1-2\" data-name=\"checkbox visual box\"><i aria-hidden=\"true\" class=\"icon-check\" data-kid=\"1-2-2-6-2-1-1-2-1\" data-name=\"checkmark icon\"></i></span>\n              Remember me\n            </label>\n<a class=\"f-link\" data-kid=\"1-2-2-6-2-1-2\" data-name=\"forgot password link\" href=\"#\">Forgot password?</a>\n</div>\n<button class=\"submit\" data-kid=\"1-2-2-6-2-2\" data-name=\"submit sign-in button\" type=\"submit\"><i aria-hidden=\"true\" class=\"icon-arrow-right\" data-kid=\"1-2-2-6-2-2-1\" data-name=\"arrow right icon\"></i>Sign in</button>\n</div>\n</div>\n<div class=\"foot-row\" data-kid=\"1-2-2-7\" data-name=\"bottom footer row with create account\">\n<span data-kid=\"1-2-2-7-1\" data-name=\"no account prompt text\">No account yet?</span>\n<a data-kid=\"1-2-2-7-2\" data-name=\"create account link\" href=\"#\">Create account<i aria-hidden=\"true\" class=\"icon-arrow-right\" data-kid=\"1-2-2-7-2-1\" data-name=\"arrow right icon\" style=\"margin-left:6px;font-size:11px\"></i></a>\n</div>\n</section>\n</section>\n<footer class=\"page-foot\" data-kid=\"1-3\" data-name=\"page footer bar\">\n<span data-kid=\"1-3-1\" data-name=\"footer brand name text\">ScamShield AI</span>\n<nav data-kid=\"1-3-2\" data-name=\"footer navigation links\"><a data-kid=\"1-3-2-1\" data-name=\"privacy policy footer link\" href=\"#\">Privacy Policy</a><a data-kid=\"1-3-2-2\" data-name=\"terms footer link\" href=\"#\">Terms</a></nav>\n<span data-kid=\"1-3-3\" data-name=\"footer session expiry note text\">Sessions expire after 1 hour</span>\n</footer>\n</main>",
