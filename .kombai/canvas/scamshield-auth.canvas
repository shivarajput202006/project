    "var_10ff238633ba": {
      "type": "variant",
      "label": "Sign in — two leaves",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n*, *::before, *::after { box-sizing: border-box; }\nbody { margin: 0; }\n\n.page {\n  min-height: 100vh; position: relative; display: flex; flex-direction: column; overflow: hidden;\n  font-family: \"DM Sans\", sans-serif; color: #f8fafc;\n  background:\n    radial-gradient(ellipse at 16% -8%, rgba(37,99,235,.22), transparent 46%),\n    radial-gradient(ellipse at 88% 96%, rgba(6,182,212,.16), transparent 44%),\n    #080d1b;\n}\n.halo { position: absolute; left: 50%; top: 50%; width: 1180px; height: 1180px; transform: translate(-50%,-50%); border-radius: 50%; pointer-events: none;\n  background: radial-gradient(circle at 50% 50%, rgba(6,182,212,.09), rgba(6,182,212,0) 62%);\n  border: 1px solid rgba(6,182,212,.07);\n  animation: breathe 9s ease-in-out infinite;\n}\n@keyframes breathe { 0%, 100% { opacity: .7; transform: translate(-50%,-50%) scale(1); } 50% { opacity: 1; transform: translate(-50%,-50%) scale(1.03); } }\n@keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }\n\n.masthead { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; height: 74px; padding: 0 44px; }\n.brand { display: inline-flex; align-items: center; gap: 10px; font-family: Manrope, sans-serif; font-size: 17px; font-weight: 800; letter-spacing: -.65px; color: #f8fafc; text-decoration: none; }\n.brand em { font-style: normal; color: #67d8ed; }\n.brand img { display: block; width: 30px; height: 30px; }\n.back-link { display: inline-flex; align-items: center; gap: 8px; padding: 9px 15px; border-radius: 999px; border: 1px solid rgba(148,163,184,.2); background: rgba(16,24,43,.55); color: #b3c0d2; font-size: 11.5px; text-decoration: none; transition: .2s ease; }\n.back-link:hover { border-color: rgba(6,182,212,.45); color: #fff; }\n.back-link i { font-size: 13px; }\n\n.fold {\n  position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr;\n  width: min(1040px, 100% - 80px); margin-block: auto; margin-inline: auto; border-radius: 24px; overflow: hidden;\n  border: 1px solid rgba(148,163,184,.17);\n  background: linear-gradient(152deg, rgba(24,36,62,.74), rgba(11,19,35,.9));\n  box-shadow: 0 0 0 1px rgba(6,182,212,.07), 0 44px 120px rgba(0,0,0,.52), inset 0 1px 0 rgba(255,255,255,.07);\n  backdrop-filter: blur(26px);\n  animation: rise .6s ease both;\n}\n.fold::before { content: \"\"; position: absolute; left: 50%; top: 26px; bottom: 26px; width: 1px; z-index: 2;\n  background: linear-gradient(180deg, transparent, rgba(148,163,184,.26) 10%, rgba(148,163,184,.26) 90%, transparent); }\n.fold::after { content: \"\"; position: absolute; inset: 0; pointer-events: none;\n  background: radial-gradient(ellipse at 8% -12%, rgba(6,182,212,.18), transparent 56%); }\n\n.leaf { position: relative; z-index: 1; padding: 40px 38px 36px; }\n.leaf-left { display: flex; flex-direction: column; background: linear-gradient(160deg, rgba(255,255,255,.05), rgba(255,255,255,0) 62%); }\n.leaf-brand { display: inline-flex; align-items: center; gap: 9px; margin-bottom: 24px; color: #d3dce8; font-family: Manrope, sans-serif; font-size: 12.5px; font-weight: 700; letter-spacing: -.3px; }\n.leaf-brand em { font-style: normal; color: #67d8ed; }\n.leaf-brand img { width: 16px; height: 16px; display: block; }\n\n.leaf-left h2 { margin: 0 0 20px; font-family: Manrope, sans-serif; font-size: 21px; font-weight: 800; letter-spacing: -.6px; }\n\n.spec { display: grid; gap: 16px; margin: 0; padding: 0; }\n.spec > div { display: grid; gap: 5px; }\n.spec dt { font-size: 10px; font-weight: 700; letter-spacing: .7px; text-transform: uppercase; color: #7d8da3; }\n.spec dd { margin: 0; color: #d3dce8; font-size: 12px; line-height: 1.6; }\n.spec dd span { color: #8b9bb0; }\n\n.leaf-rule { height: 1px; margin: 24px 0 20px; background: linear-gradient(90deg, rgba(6,182,212,.5), rgba(148,163,184,.1), transparent); }\n\n.leaf-left h3 { margin: 0 0 13px; font-family: Manrope, sans-serif; font-size: 12.5px; font-weight: 700; color: #e2e9f3; }\n.mods { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 14px; margin: 0; padding: 0; list-style: none; }\n.mods li { display: flex; align-items: center; gap: 8px; color: #a9b7c9; font-size: 11px; }\n.mods i { font-size: 14px; color: #4fbfd4; }\n\n.leaf-foot { display: flex; align-items: center; gap: 8px; margin-top: auto; padding: 11px 13px; border-radius: 12px; border: 1px solid rgba(148,163,184,.14); background: rgba(5,11,22,.5); color: #92a1b5; font-size: 10.5px; }\n.mods { margin-bottom: 22px; }\n.leaf-foot i { font-size: 14px; color: #4fbfd4; }\n\n.leaf-right h1 { margin: 0 0 6px; font-family: Manrope, sans-serif; font-size: 27px; font-weight: 800; letter-spacing: -.9px; }\n.right-lede { margin: 0 0 24px; color: #93a2b7; font-size: 11.5px; line-height: 1.7; }\n\n.method { display: flex; align-items: center; gap: 11px; width: 100%; min-height: 50px; margin-bottom: 10px; padding: 0 18px;\n  border-radius: 999px; border: 1px solid rgba(148,163,184,.19);\n  background: linear-gradient(150deg, rgba(255,255,255,.06), rgba(255,255,255,.015));\n  box-shadow: inset 0 1px 0 rgba(255,255,255,.07);\n  color: #e8eef7; font-family: inherit; font-size: 12.5px; font-weight: 600; text-align: left; cursor: pointer;\n  transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease, background .2s ease;\n}\n.method:hover { transform: translateY(-1px); border-color: rgba(6,182,212,.45); background: linear-gradient(150deg, rgba(6,182,212,.16), rgba(37,99,235,.08)); box-shadow: 0 10px 30px rgba(6,182,212,.12), inset 0 1px 0 rgba(255,255,255,.09); }\n.method .mark { display: grid; place-items: center; width: 20px; height: 20px; }\n.method .mark svg { width: 16px; height: 16px; display: block; }\n.method .mark i { font-size: 16px; color: #9fb2c8; }\n.method .kbd { margin-left: auto; color: #6a7c93; font-size: 10px; font-weight: 500; }\n.method.is-open { border-color: rgba(34,211,238,.55); background: linear-gradient(150deg, rgba(6,182,212,.14), rgba(37,99,235,.07)); box-shadow: 0 0 0 4px rgba(6,182,212,.09), inset 0 1px 0 rgba(255,255,255,.09); }\n.method.is-open .mark i { color: #7fe4f2; }\n.method.is-open .kbd { color: #7fd9e6; }\n\n.fields { display: grid; gap: 10px; margin: 4px 0 0; padding: 0 4px; }\n.pill { display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 18px; border-radius: 999px;\n  border: 1px solid rgba(148,163,184,.19); background: rgba(5,11,22,.55); color: #7c8ca2;\n  box-shadow: inset 0 2px 8px rgba(0,0,0,.45);\n  transition: border-color .2s ease, box-shadow .2s ease, color .2s ease;\n}\n.pill:focus-within { border-color: rgba(34,211,238,.6); color: #8fe3f0; box-shadow: inset 0 2px 8px rgba(0,0,0,.45), 0 0 0 4px rgba(6,182,212,.1); }\n.pill i { font-size: 15px; }\n.pill input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; color: #f1f5f9; font-family: inherit; font-size: 12px; }\n.pill input::placeholder { color: #5e6d84; }\n.ptoggle { display: grid; place-items: center; border: 0; padding: 4px; background: none; color: #8290a5; font-size: 15px; cursor: pointer; }\n.ptoggle:hover { color: #d7e3f2; }\n\n.between { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 16px 2px 0; }\n.toggle { display: inline-flex; align-items: center; gap: 9px; color: #a9b7c9; font-size: 11px; cursor: pointer; }\n.toggle input { position: absolute; opacity: 0; pointer-events: none; }\n.toggle .track { position: relative; width: 34px; height: 19px; border-radius: 999px; background: rgba(148,163,184,.24); box-shadow: inset 0 1px 3px rgba(0,0,0,.5); transition: background .2s ease; }\n.toggle .track::after { content: \"\"; position: absolute; top: 3px; left: 3px; width: 13px; height: 13px; border-radius: 50%; background: #cbd5e1; transition: transform .2s ease, background .2s ease; }\n.toggle input:checked + .track { background: rgba(6,182,212,.55); }\n.toggle input:checked + .track::after { transform: translateX(15px); background: #effeff; }\n.f-link { color: #6bcfe0; font-size: 10.5px; font-weight: 600; text-decoration: none; }\n.f-link:hover { color: #a1e5ef; }\n\n.submit { display: flex; align-items: center; justify-content: center; gap: 9px; width: 100%; min-height: 50px; margin-top: 18px;\n  border: 0; border-radius: 999px; background: #2563eb; color: #fff;\n  font-family: inherit; font-size: 12.5px; font-weight: 700; letter-spacing: .2px; cursor: pointer;\n  box-shadow: 0 12px 34px rgba(37,99,235,.4), 0 0 0 1px rgba(103,232,249,.26), inset 0 1px 0 rgba(255,255,255,.24);\n  transition: transform .2s ease, box-shadow .2s ease;\n}\n.submit:hover { transform: translateY(-1px); box-shadow: 0 16px 40px rgba(37,99,235,.5), 0 0 0 1px rgba(103,232,249,.4), inset 0 1px 0 rgba(255,255,255,.28); }\n.submit i { font-size: 15px; }\n\n.switch { margin: 18px 0 0; text-align: center; color: #93a2b7; font-size: 11px; }\n.switch a { color: #6bcfe0; font-weight: 600; text-decoration: none; }\n.switch a:hover { color: #a1e5ef; }\n\n.page-foot { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 22px; padding: 16px 44px; color: #738298; font-size: 9.5px; }\n.page-foot nav { display: flex; gap: 22px; }\n.page-foot nav a { color: #8290a5; text-decoration: none; }\n.page-foot nav a:hover { color: #d6e5f6; }\n\n@media (max-width: 940px) {\n  .fold { grid-template-columns: 1fr; width: min(520px, calc(100% - 40px)); }\n  .fold::before { display: none; }\n  .leaf-left { order: 2; padding: 28px 26px 30px; border-top: 1px solid rgba(148,163,184,.16); }\n  .leaf-right { order: 1; padding: 32px 26px 28px; }\n  .leaf-brand { display: none; }\n  .leaf-left h2 { font-size: 17px; margin-bottom: 16px; }\n  .mods { grid-template-columns: 1fr; }\n  .masthead { height: 66px; padding: 0 20px; }\n  .masthead .back-link { display: none; }\n  .page-foot { flex-direction: column; gap: 8px; align-items: center; padding: 14px 20px; }\n}\n</style>\n<main class=\"page\" data-kid=\"1\" data-name=\"page layout container (auth screen)\">\n<div aria-hidden=\"true\" class=\"halo\" data-kid=\"1-1\" data-name=\"decorative radial halo\"></div>\n<header class=\"masthead\" data-kid=\"1-2\" data-name=\"top masthead bar\">\n<a class=\"brand\" data-kid=\"1-2-1\" data-name=\"brand logo link\" href=\"#\"><img alt=\"\" data-kid=\"1-2-1-1\" data-name=\"brand shield logo image\" height=\"30\" src=\"/api/local/images/ScamShield-AI/frontend/public/shield.svg\" width=\"30\"/><span data-kid=\"1-2-1-2\" data-name=\"brand wordmark text\">ScamShield<em data-kid=\"1-2-1-2-1\" data-name='brand name accent \"AI\" suffix'> AI</em></span></a>\n<a class=\"back-link\" data-kid=\"1-2-2\" data-name=\"back-to-home pill link\" href=\"#\"><i aria-hidden=\"true\" class=\"icon-arrow-left\" data-kid=\"1-2-2-1\" data-name=\"left arrow icon\"></i>Back to home</a>\n</header>\n<section class=\"fold\" data-kid=\"1-3\" data-name=\"folded sign-in card\">\n<aside class=\"leaf leaf-left\" data-kid=\"1-3-1\" data-name=\"left info panel\">\n<h2 data-kid=\"1-3-1-1\" data-name=\"left panel section heading\">What each method shares</h2>\n<dl class=\"spec\" data-kid=\"1-3-1-2\" data-name=\"method data spec list\">\n<div data-kid=\"1-3-1-2-1\" data-name=\"GitHub spec row\">\n<dt data-kid=\"1-3-1-2-1-1\" data-name=\"GitHub spec label\">GitHub</dt>\n<dd data-kid=\"1-3-1-2-1-2\" data-name=\"GitHub spec detail text\">Public profile and primary email <span data-kid=\"1-3-1-2-1-2-1\" data-name=\"GitHub privacy note span\">— no repositories, organisations or gists</span></dd>\n</div>\n<div data-kid=\"1-3-1-2-2\" data-name=\"LinkedIn spec row\">\n<dt data-kid=\"1-3-1-2-2-1\" data-name=\"LinkedIn spec label\">LinkedIn</dt>\n<dd data-kid=\"1-3-1-2-2-2\" data-name=\"LinkedIn spec detail text\">Name and verified email <span data-kid=\"1-3-1-2-2-2-1\" data-name=\"LinkedIn privacy note span\">— no connections or work history</span></dd>\n</div>\n<div data-kid=\"1-3-1-2-3\" data-name=\"Email/password spec row\">\n<dt data-kid=\"1-3-1-2-3-1\" data-name=\"Email/password spec label\">Email and password</dt>\n<dd data-kid=\"1-3-1-2-3-2\" data-name=\"Email/password spec detail text\">Your email address and a password hashed with BCrypt <span data-kid=\"1-3-1-2-3-2-1\" data-name=\"BCrypt hashing note span\">— never stored as text</span></dd>\n</div>\n</dl>\n<div class=\"leaf-rule\" data-kid=\"1-3-1-3\" data-name=\"left panel divider rule\"></div>\n<h3 data-kid=\"1-3-1-4\" data-name=\"available features heading\">Available after sign in</h3>\n<ul class=\"mods\" data-kid=\"1-3-1-5\" data-name=\"post-sign-in features list\">\n<li data-kid=\"1-3-1-5-1\" data-name=\"feature list item: scam detection\"><i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-3-1-5-1-1\" data-name=\"shield-check icon\"></i>Scam detection</li>\n<li data-kid=\"1-3-1-5-2\" data-name=\"feature list item: URL scanner\"><i aria-hidden=\"true\" class=\"icon-link\" data-kid=\"1-3-1-5-2-1\" data-name=\"link icon\"></i>URL scanner</li>\n<li data-kid=\"1-3-1-5-3\" data-name=\"feature list item: resume analyzer\"><i aria-hidden=\"true\" class=\"icon-file-text\" data-kid=\"1-3-1-5-3-1\" data-name=\"file-text icon\"></i>Resume analyzer</li>\n<li data-kid=\"1-3-1-5-4\" data-name=\"feature list item: job finder\"><i aria-hidden=\"true\" class=\"icon-briefcase\" data-kid=\"1-3-1-5-4-1\" data-name=\"briefcase icon\"></i>Job finder</li>\n</ul>\n<div class=\"leaf-foot\" data-kid=\"1-3-1-6\" data-name=\"session expiry info box\"><i aria-hidden=\"true\" class=\"icon-lock-keyhole\" data-kid=\"1-3-1-6-1\" data-name=\"lock-keyhole icon\"></i>Session expires after 1 hour. Refresh keeps you signed in.</div>\n</aside>\n<div class=\"leaf leaf-right\" data-kid=\"1-3-2\" data-name=\"right sign-in form panel\">\n<h1 data-kid=\"1-3-2-1\" data-name=\"sign-in heading\">Sign in</h1>\n<p class=\"right-lede\" data-kid=\"1-3-2-2\" data-name=\"sign-in lede description\">Continue to your dashboard.</p>\n<button class=\"method\" data-kid=\"1-3-2-3\" data-name=\"GitHub sign-in method button\" type=\"button\">\n<span class=\"mark\" data-kid=\"1-3-2-3-1\" data-name=\"GitHub icon mark container\"><svg aria-hidden=\"true\" data-kid=\"1-3-2-3-1-1\" data-name=\"GitHub logo icon\" viewbox=\"0 0 24 24\"><path d=\"M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12\" fill=\"#e8eef8\"></path></svg></span>\n        Continue with GitHub\n        <span class=\"kbd\" data-kid=\"1-3-2-3-2\" data-name=\"method kbd hint label\">profile, email</span>\n</button>\n<button class=\"method\" data-kid=\"1-3-2-4\" data-name=\"LinkedIn sign-in method button\" type=\"button\">\n<span class=\"mark\" data-kid=\"1-3-2-4-1\" data-name=\"LinkedIn icon mark container\"><svg aria-hidden=\"true\" data-kid=\"1-3-2-4-1-1\" data-name=\"LinkedIn logo icon\" viewbox=\"0 0 24 24\"><path d=\"M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z\" fill=\"#5aa9ef\"></path></svg></span>\n        Continue with LinkedIn\n        <span class=\"kbd\" data-kid=\"1-3-2-4-2\" data-name=\"method kbd hint label\">openid, email</span>\n</button>\n<button class=\"method is-open\" data-kid=\"1-3-2-5\" data-name=\"email/password method button (open)\" type=\"button\">\n<span class=\"mark\" data-kid=\"1-3-2-5-1\" data-name=\"email icon mark container\"><i aria-hidden=\"true\" class=\"icon-mail\" data-kid=\"1-3-2-5-1-1\" data-name=\"email icon\"></i></span>\n        Email and password\n        <span class=\"kbd\" data-kid=\"1-3-2-5-2\" data-name=\"method kbd hint label\">open</span>\n</button>\n<div class=\"fields\" data-kid=\"1-3-2-6\" data-name=\"form fields container\">\n<label class=\"pill\" data-kid=\"1-3-2-6-1\" data-name=\"email input pill\">\n<i aria-hidden=\"true\" class=\"icon-mail\" data-kid=\"1-3-2-6-1-1\" data-name=\"email pill icon\"></i>\n<input aria-label=\"Email address\" autocomplete=\"email\" data-kid=\"1-3-2-6-1-2\" data-name=\"email address input field\" name=\"email\" placeholder=\"you@example.com\" type=\"email\"/>\n</label>\n<div class=\"pill\" data-kid=\"1-3-2-6-2\" data-name=\"password input pill\">\n<i aria-hidden=\"true\" class=\"icon-lock-keyhole\" data-kid=\"1-3-2-6-2-1\" data-name=\"password pill lock icon\"></i>\n<input aria-label=\"Password\" autocomplete=\"current-password\" data-kid=\"1-3-2-6-2-2\" data-name=\"password input field\" name=\"password\" placeholder=\"Password\" type=\"password\"/>\n<button aria-label=\"Show password\" class=\"ptoggle\" data-kid=\"1-3-2-6-2-3\" data-name=\"show/hide password toggle button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-eye\" data-kid=\"1-3-2-6-2-3-1\" data-name=\"eye icon\"></i></button>\n</div>\n</div>\n<div class=\"between\" data-kid=\"1-3-2-7\" data-name=\"remember-me and forgot row\">\n<label class=\"toggle\" data-kid=\"1-3-2-7-1\" data-name=\"remember me toggle\">\n<input checked=\"\" data-kid=\"1-3-2-7-1-1\" data-name=\"remember me checkbox input\" type=\"checkbox\"/>\n<span class=\"track\" data-kid=\"1-3-2-7-1-2\" data-name=\"toggle track\"></span>\n          Remember me\n        </label>\n<a class=\"f-link\" data-kid=\"1-3-2-7-2\" data-name=\"forgot password link\" href=\"#\">Forgot password?</a>\n</div>\n<button class=\"submit\" data-kid=\"1-3-2-8\" data-name=\"primary sign-in submit button\" type=\"submit\"><i aria-hidden=\"true\" class=\"icon-arrow-right\" data-kid=\"1-3-2-8-1\" data-name=\"arrow-right icon\"></i>Sign in with email</button>\n<p class=\"switch\" data-kid=\"1-3-2-9\" data-name=\"switch account prompt\">New to ScamShield AI? <a data-kid=\"1-3-2-9-1\" data-name=\"create account link\" href=\"#\">Create an account</a></p>\n</div>\n</section>\n<footer class=\"page-foot\" data-kid=\"1-4\" data-name=\"page footer bar\">\n<span data-kid=\"1-4-1\" data-name=\"footer brand text\">ScamShield AI</span>\n<nav data-kid=\"1-4-2\" data-name=\"footer navigation\"><a data-kid=\"1-4-2-1\" data-name=\"footer privacy policy link\" href=\"#\">Privacy Policy</a><a data-kid=\"1-4-2-2\" data-name=\"footer terms link\" href=\"#\">Terms</a><a data-kid=\"1-4-2-3\" data-name=\"footer help link\" href=\"#\">Help</a></nav>\n<span data-kid=\"1-4-3\" data-name=\"footer OAuth note text\">OAuth handled on the server</span>\n</footer>\n</main>",
      "comments": [],
      "created": "2026-11-13T19:04:27.045670+00:00",
      "modified": "2026-11-13T19:06:26.205997+00:00",
