      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n*, *::before, *::after { box-sizing: border-box; }\nbody { margin: 0; }\n\n.auth-page {\n  --bg: #080d1b; --surface: #10182b; --blue: #2563eb; --cyan: #06b6d4;\n  --text: #f8fafc; --muted: #94a3b8; --line: rgba(148,163,184,.13);\n  min-height: 100vh; position: relative; display: flex; flex-direction: column; overflow: hidden;\n  color: var(--text); font-family: \"DM Sans\", sans-serif;\n  background:\n    radial-gradient(ellipse at 6% 4%, rgba(6,182,212,.11), transparent 40%),\n    radial-gradient(ellipse at 92% 88%, rgba(37,99,235,.13), transparent 44%),\n    var(--bg);\n}\n.auth-page::before {\n  content: \"\"; position: absolute; inset: 0 0 auto; height: 44px; pointer-events: none;\n  background-image: repeating-linear-gradient(90deg, rgba(148,163,184,.22) 0 1px, transparent 1px 13px);\n  -webkit-mask-image: linear-gradient(180deg, #000, transparent);\n  mask-image: linear-gradient(180deg, #000, transparent);\n  opacity: .55;\n}\n\n.masthead { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; height: 76px; padding: 0 44px; border-bottom: 1px solid rgba(148,163,184,.1); }\n.brand { display: inline-flex; align-items: center; gap: 10px; font-family: Manrope, sans-serif; font-size: 17px; font-weight: 800; letter-spacing: -.65px; color: var(--text); text-decoration: none; }\n.brand em { font-style: normal; color: #67d8ed; }\n.brand img { display: block; width: 30px; height: 30px; }\n.back-link { display: inline-flex; align-items: center; gap: 8px; color: #a4b0c2; font-size: 12px; text-decoration: none; transition: color .2s ease; }\n.back-link:hover { color: #fff; }\n.back-link i { font-size: 14px; }\n\n.stage { position: relative; z-index: 1; flex: 1; display: grid; grid-template-columns: minmax(0,1fr) 452px; align-items: center; gap: 56px; width: min(1120px, 100% - 88px); margin: 0 auto; padding: 50px 0 34px; }\n\n.signal { position: relative; width: 100%; max-width: 600px; }\n.signal svg { display: block; width: 100%; height: auto; overflow: visible; }\n.sig-label { position: absolute; left: 0; width: 190px; transform: translateY(-50%); display: grid; grid-template-columns: 20px 1fr; gap: 10px; align-items: center; }\n.sig-label .mark { display: grid; place-items: center; width: 20px; height: 20px; color: #93a3b9; }\n.sig-label .mark svg { width: 15px; height: 15px; display: block; }\n.sig-label strong { display: block; font-size: 12px; font-weight: 600; color: #ccd7e5; letter-spacing: -.1px; }\n.sig-label span { display: block; margin-top: 2px; font-size: 10px; color: #75849a; }\n.sig-label.is-live strong { color: #96ecf7; }\n.sig-label.is-live .mark { color: #5fd6e9; }\n.sig-1 { top: 21%; }\n.sig-2 { top: 50%; }\n.sig-3 { top: 79%; }\n\n@keyframes dash { to { stroke-dashoffset: 0; } }\n@keyframes breathe { 0%, 100% { opacity: .45; } 50% { opacity: .85; } }\n.signal .halo { animation: breathe 6s ease-in-out infinite; transform-origin: 470px 200px; }\n\n.card { position: relative; border: 1px solid rgba(148,163,184,.17); border-radius: 10px; padding: 28px 27px 24px;\n  background: linear-gradient(158deg, rgba(20,31,52,.93), rgba(10,17,31,.97));\n  box-shadow: inset 0 1px 0 rgba(255,255,255,.05), inset 0 -1px 0 rgba(0,0,0,.45), 0 0 0 1px rgba(6,182,212,.055), 0 30px 90px rgba(0,0,0,.42);\n  backdrop-filter: blur(18px);\n}\n.card::before {\n  content: \"\"; position: absolute; inset: 0 0 auto; height: 7px; border-radius: 10px 10px 0 0; opacity: .5;\n  background-image: repeating-linear-gradient(90deg, rgba(148,163,184,.35) 0 1px, transparent 1px 9px);\n}\n.card h1 { margin: 10px 0 7px; font-family: Manrope, sans-serif; font-size: 25px; font-weight: 800; letter-spacing: -.85px; line-height: 1.22; }\n.card-lede { margin: 0 0 18px; color: #93a2b7; font-size: 12px; line-height: 1.7; }\n.card-rule { position: relative; height: 1px; margin-bottom: 18px; background: rgba(148,163,184,.13); }\n.card-rule span { position: absolute; left: 0; top: 0; width: 46px; height: 1px; background: linear-gradient(90deg, #22d3ee, transparent); }\n\n.provider { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 48px; margin-bottom: 8px; padding: 0 14px;\n  border: 1px solid rgba(148,163,184,.16); border-radius: 4px 10px 4px 4px; background: rgba(255,255,255,.018);\n  color: #e7edf6; font-family: inherit; font-size: 12.5px; font-weight: 600; text-align: left; cursor: pointer;\n  position: relative; transition: border-color .2s ease, background .2s ease, transform .2s ease;\n}\n.provider::after { content: \"\"; position: absolute; top: 0; right: 0; width: 9px; height: 9px; border-top: 1px solid rgba(6,182,212,.5); border-right: 1px solid rgba(6,182,212,.5); border-radius: 0 10px 0 0; }\n.provider:hover { border-color: rgba(6,182,212,.42); background: rgba(6,182,212,.05); transform: translateY(-1px); }\n.provider .mark { display: grid; place-items: center; width: 22px; height: 22px; }\n.provider .mark svg { width: 17px; height: 17px; display: block; }\n.provider .kbd { margin-left: auto; color: #64748b; font-size: 10px; font-weight: 500; letter-spacing: .3px; }\n\n.disclosure { display: flex; align-items: center; gap: 10px; width: 100%; margin: 16px 0 0; padding: 0; border: 0; background: none; color: #c8d4e3; font-family: inherit; font-size: 11.5px; font-weight: 600; cursor: pointer; }\n.disclosure i:first-child { font-size: 14px; color: #8ba0b8; }\n.disclosure .ln { flex: 1; height: 1px; background: rgba(148,163,184,.16); }\n.disclosure .chev { font-size: 14px; color: #6b7c93; }\n\n.field { margin-top: 13px; }\n.f-label { display: block; margin-bottom: 7px; color: #d5dfeb; font-size: 11px; font-weight: 600; }\n.f-row { display: flex; align-items: center; justify-content: space-between; margin: 15px 0 7px; }\n.f-row .f-label { margin: 0; }\n.f-link { color: #6bcfe0; font-size: 10px; font-weight: 600; text-decoration: none; }\n.f-link:hover { color: #a1e5ef; }\n\n.well { display: flex; align-items: center; gap: 10px; min-height: 46px; padding: 0 12px; border-radius: 6px;\n  border: 1px solid rgba(148,163,184,.17); background: rgba(4,9,19,.72); color: #6b7b91;\n  box-shadow: inset 0 2px 6px rgba(0,0,0,.5), inset 0 -1px 0 rgba(255,255,255,.03);\n  transition: border-color .2s ease, box-shadow .2s ease, color .2s ease;\n}\n.well:focus-within { border-color: rgba(6,182,212,.6); color: #8fe3f0; box-shadow: inset 0 2px 6px rgba(0,0,0,.5), 0 0 0 3px rgba(6,182,212,.08); }\n.well i { font-size: 15px; }\n.well input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; color: #f1f5f9; font-family: inherit; font-size: 12px; }\n.well input::placeholder { color: #5c6b82; }\n.ptoggle { display: grid; place-items: center; border: 0; padding: 3px; background: none; color: #7e8da3; font-size: 15px; cursor: pointer; }\n.ptoggle:hover { color: #d7e3f2; }\n\n.check { display: inline-flex; align-items: center; gap: 8px; margin-top: 14px; color: #a2b0c3; font-size: 11px; cursor: pointer; }\n.check input { position: absolute; opacity: 0; pointer-events: none; }\n.check .box { display: grid; place-items: center; width: 14px; height: 14px; border-radius: 3px; border: 1px solid rgba(148,163,184,.36); background: rgba(4,9,19,.7); color: transparent; font-size: 9px; transition: .18s ease; }\n.check input:checked + .box { border-color: rgba(6,182,212,.75); background: rgba(6,182,212,.2); color: #a5f3fc; }\n\n.submit { display: flex; align-items: center; justify-content: center; gap: 9px; width: 100%; min-height: 46px; margin-top: 18px;\n  border: 1px solid rgba(96,165,250,.5); border-radius: 6px; background: #2563eb; color: #fff;\n  font-family: inherit; font-size: 12.5px; font-weight: 700; letter-spacing: .2px; cursor: pointer;\n  box-shadow: 0 8px 24px rgba(37,99,235,.3), inset 0 1px 0 rgba(255,255,255,.2);\n  transition: transform .18s ease, box-shadow .18s ease;\n}\n.submit:hover { transform: translateY(-1px); box-shadow: 0 12px 30px rgba(37,99,235,.42), inset 0 1px 0 rgba(255,255,255,.24); }\n.submit i { font-size: 15px; }\n\n.switch { margin: 17px 0 0; text-align: center; color: #93a2b7; font-size: 11px; }\n.switch a { color: #6bcfe0; font-weight: 600; text-decoration: none; }\n.switch a:hover { color: #a1e5ef; }\n\n.page-foot { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 22px; padding: 17px 44px; border-top: 1px solid rgba(148,163,184,.09); color: #738298; font-size: 9.5px; }\n.page-foot .foot-brand { display: inline-flex; align-items: center; gap: 7px; color: #92a1b5; }\n.page-foot nav { display: flex; gap: 20px; }\n.page-foot nav a { color: #8290a5; text-decoration: none; }\n.page-foot nav a:hover { color: #d6e5f6; }\n\n@media (max-width: 1080px) {\n  .stage { grid-template-columns: minmax(0,1fr); justify-items: center; padding: 34px 0; }\n  .signal { display: none; }\n}\n@media (max-width: 560px) {\n  .masthead { height: 66px; padding: 0 18px; }\n  .stage { width: calc(100% - 32px); }\n  .card { padding: 24px 19px 20px; }\n  .card h1 { font-size: 22px; }\n  .page-foot { flex-direction: column; gap: 8px; align-items: flex-start; padding: 14px 18px; }\n}\n</style>\n<main class=\"auth-page\" data-kid=\"1\" data-name=\"authentication page layout container\">\n<header class=\"masthead\" data-kid=\"1-1\" data-name=\"page masthead header bar\">\n<a class=\"brand\" data-kid=\"1-1-1\" data-name=\"ScamShield AI brand logo link\" href=\"#\"><img alt=\"\" data-kid=\"1-1-1-1\" data-name=\"brand shield logo image\" height=\"30\" src=\"/api/local/images/ScamShield-AI/frontend/public/shield.svg\" width=\"30\"/><span data-kid=\"1-1-1-2\" data-name=\"brand name text\">ScamShield<em data-kid=\"1-1-1-2-1\" data-name=\"brand name accent suffix\"> AI</em></span></a>\n<a class=\"back-link\" data-kid=\"1-1-2\" data-name=\"back to home navigation link\" href=\"#\"><i aria-hidden=\"true\" class=\"icon-arrow-left\" data-kid=\"1-1-2-1\" data-name=\"left arrow icon on back link\"></i>Back to home</a>\n</header>\n<section class=\"stage\" data-kid=\"1-2\" data-name=\"main stage grid with illustration and form\">\n<div class=\"signal\" data-kid=\"1-2-1\" data-name=\"connection diagram illustration container\">\n<svg aria-hidden=\"true\" data-kid=\"1-2-1-1\" data-name=\"decorative SVG signal diagram\" viewbox=\"0 0 520 400\">\n<defs>\n<lineargradient id=\"litLine\" x1=\"0\" x2=\"1\" y1=\"0\" y2=\"0\">\n<stop offset=\"0\" stop-color=\"#06b6d4\" stop-opacity=\".1\"></stop>\n<stop offset=\".55\" stop-color=\"#22d3ee\" stop-opacity=\".8\"></stop>\n<stop offset=\"1\" stop-color=\"#67e8f9\"></stop>\n</lineargradient>\n<radialgradient cx=\".5\" cy=\".5\" id=\"haloGrad\" r=\".5\">\n<stop offset=\"0\" stop-color=\"#06b6d4\" stop-opacity=\".5\"></stop>\n<stop offset=\"1\" stop-color=\"#06b6d4\" stop-opacity=\"0\"></stop>\n</radialgradient>\n<filter id=\"softGlow\"><fegaussianblur stddeviation=\"3.2\"></fegaussianblur></filter>\n</defs>\n<circle class=\"halo\" cx=\"470\" cy=\"200\" fill=\"url(#haloGrad)\" opacity=\".55\" r=\"86\"></circle>\n<path d=\"M186 84 C320 84 372 140 452 186\" fill=\"none\" stroke=\"rgba(148,163,184,.26)\" stroke-dasharray=\"360\" stroke-dashoffset=\"360\" stroke-width=\"1\" style=\"animation:dash 1.5s ease .15s forwards\"></path>\n<path d=\"M186 200 H452\" fill=\"none\" stroke=\"rgba(148,163,184,.26)\" stroke-dasharray=\"360\" stroke-dashoffset=\"360\" stroke-width=\"1\" style=\"animation:dash 1.5s ease .3s forwards\"></path>\n<path d=\"M186 316 C320 316 372 260 452 214\" fill=\"none\" stroke=\"url(#litLine)\" stroke-dasharray=\"360\" stroke-dashoffset=\"360\" stroke-width=\"1.4\" style=\"animation:dash 1.8s ease .45s forwards\"></path>\n<path d=\"M186 316 C320 316 372 260 452 214\" fill=\"none\" filter=\"url(#softGlow)\" stroke=\"#22d3ee\" stroke-opacity=\".35\" stroke-width=\"1.4\"></path>\n<circle cx=\"186\" cy=\"84\" fill=\"rgba(148,163,184,.5)\" r=\"2.4\"></circle>\n<circle cx=\"186\" cy=\"200\" fill=\"rgba(148,163,184,.5)\" r=\"2.4\"></circle>\n<circle cx=\"186\" cy=\"316\" fill=\"#22d3ee\" r=\"3\"></circle>\n<g transform=\"translate(452 176) scale(.94)\">\n<path d=\"M24 4 41 11v11c0 11.2-7.3 18.2-17 22C14.3 40.2 7 33.2 7 22V11L24 4Z\" fill=\"#2563EB\"></path>\n<path d=\"m17 24 4.5 4.5L31.5 18\" fill=\"none\" stroke=\"#E0F2FE\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"3\"></path>\n</g>\n</svg>\n<div class=\"sig-label sig-1\" data-kid=\"1-2-1-2\" data-name=\"GitHub signal label\">\n<span class=\"mark\" data-kid=\"1-2-1-2-1\" data-name=\"GitHub signal label icon box\"><svg aria-hidden=\"true\" data-kid=\"1-2-1-2-1-1\" data-name=\"GitHub logo icon\" viewbox=\"0 0 24 24\"><path d=\"M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12\" fill=\"currentColor\"></path></svg></span>\n<span data-kid=\"1-2-1-2-2\" data-name=\"GitHub signal label text block\"><strong data-kid=\"1-2-1-2-2-1\" data-name=\"GitHub label heading\">GitHub</strong><span data-kid=\"1-2-1-2-2-2\" data-name=\"GitHub label description text\">Profile, primary email</span></span>\n</div>\n<div class=\"sig-label sig-2\" data-kid=\"1-2-1-3\" data-name=\"LinkedIn signal label\">\n<span class=\"mark\" data-kid=\"1-2-1-3-1\" data-name=\"LinkedIn signal label icon box\"><svg aria-hidden=\"true\" data-kid=\"1-2-1-3-1-1\" data-name=\"LinkedIn logo icon\" viewbox=\"0 0 24 24\"><path d=\"M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z\" fill=\"currentColor\"></path></svg></span>\n<span data-kid=\"1-2-1-3-2\" data-name=\"LinkedIn signal label text block\"><strong data-kid=\"1-2-1-3-2-1\" data-name=\"LinkedIn label heading\">LinkedIn</strong><span data-kid=\"1-2-1-3-2-2\" data-name=\"LinkedIn label description text\">Name, verified email</span></span>\n</div>\n<div class=\"sig-label is-live sig-3\" data-kid=\"1-2-1-4\" data-name=\"email and password signal label (active/false)\">\n<span class=\"mark\" data-kid=\"1-2-1-4-1\" data-name=\"email signal label icon box\"><i aria-hidden=\"true\" class=\"icon-mail\" data-kid=\"1-2-1-4-1-1\" data-name=\"envelope icon for email label\"></i></span>\n<span data-kid=\"1-2-1-4-2\" data-name=\"email signal label text block\"><strong data-kid=\"1-2-1-4-2-1\" data-name=\"email label heading\">Email and password</strong><span data-kid=\"1-2-1-4-2-2\" data-name=\"email label description text\">Open on this screen</span></span>\n</div>\n</div>\n<div class=\"track\" data-kid=\"1-2-2\" data-name=\"form track container\">\n<div class=\"card\" data-kid=\"1-2-2-1\" data-name=\"sign-in card panel\">\n<h1 data-kid=\"1-2-2-1-1\" data-name=\"sign-in card headline\">Sign in to ScamShield AI</h1>\n<p class=\"card-lede\" data-kid=\"1-2-2-1-2\" data-name=\"card lead paragraph\">Access your scan history, reports and saved jobs.</p>\n<div class=\"card-rule\" data-kid=\"1-2-2-1-3\" data-name=\"decorative card divider rule\"><span data-kid=\"1-2-2-1-3-1\" data-name=\"accent segment of card divider\"></span></div>\n<button class=\"provider\" data-kid=\"1-2-2-1-4\" data-name=\"continue with GitHub OAuth button\" type=\"button\">\n<span class=\"mark\" data-kid=\"1-2-2-1-4-1\" data-name=\"GitHub button icon container\"><svg aria-hidden=\"true\" data-kid=\"1-2-2-1-4-1-1\" data-name=\"GitHub mark icon inside button\" viewbox=\"0 0 24 24\"><path d=\"M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12\" fill=\"#e8eef8\"></path></svg></span>\n          Continue with GitHub\n          <span class=\"kbd\" data-kid=\"1-2-2-1-4-2\" data-name=\"GitHub scope hint badge\">read:user</span>\n</button>\n<button class=\"provider\" data-kid=\"1-2-2-1-5\" data-name=\"continue with LinkedIn OAuth button\" type=\"button\">\n<span class=\"mark\" data-kid=\"1-2-2-1-5-1\" data-name=\"LinkedIn button icon container\"><svg aria-hidden=\"true\" data-kid=\"1-2-2-1-5-1-1\" data-name=\"LinkedIn mark icon inside button\" viewbox=\"0 0 24 24\"><path d=\"M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z\" fill=\"#5aa9ef\"></path></svg></span>\n          Continue with LinkedIn\n          <span class=\"kbd\" data-kid=\"1-2-2-1-5-2\" data-name=\"LinkedIn scope hint badge\">openid</span>\n</button>\n<button class=\"disclosure\" data-kid=\"1-2-2-1-6\" data-name=\"show email password section disclosure toggle\" type=\"button\">\n<i aria-hidden=\"true\" class=\"icon-mail\" data-kid=\"1-2-2-1-6-1\" data-name=\"envelope icon on disclosure toggle\"></i>\n<span data-kid=\"1-2-2-1-6-2\" data-name=\"disclosure toggle label text\">Email and password</span>\n<span class=\"ln\" data-kid=\"1-2-2-1-6-3\" data-name=\"disclosure horizontal rule filler\"></span>\n<i aria-hidden=\"true\" class=\"icon-chevron-up chev\" data-kid=\"1-2-2-1-6-4\" data-name=\"chevron up icon on disclosure toggle\"></i>\n</button>\n<div class=\"field\" data-kid=\"1-2-2-1-7\" data-name=\"email field wrapper\">\n<label class=\"f-label\" data-kid=\"1-2-2-1-7-1\" data-name=\"email field label\" for=\"a-email\">Email address</label>\n<div class=\"well\" data-kid=\"1-2-2-1-7-2\" data-name=\"email input fieldwell\">\n<i aria-hidden=\"true\" class=\"icon-mail\" data-kid=\"1-2-2-1-7-2-1\" data-name=\"envelope icon in email field\"></i>\n<input autocomplete=\"email\" data-kid=\"1-2-2-1-7-2-2\" data-name=\"email address input field\" id=\"a-email\" name=\"email\" placeholder=\"you@example.com\" type=\"email\"/>\n</div>\n</div>\n<div class=\"field\" data-kid=\"1-2-2-1-8\" data-name=\"password field wrapper\" style=\"margin-top:0\">\n<div class=\"f-row\" data-kid=\"1-2-2-1-8-1\" data-name=\"labels row for password field\">\n<label class=\"f-label\" data-kid=\"1-2-2-1-8-1-1\" data-name=\"password field label\" for=\"a-password\">Password</label>\n<a class=\"f-link\" data-kid=\"1-2-2-1-8-1-2\" data-name=\"forgot password link\" href=\"#\">Forgot password?</a>\n</div>\n<div class=\"well\" data-kid=\"1-2-2-1-8-2\" data-name=\"password input field well\">\n<i aria-hidden=\"true\" class=\"icon-lock-keyhole\" data-kid=\"1-2-2-1-8-2-1\" data-name=\"lock keyhole icon in password field\"></i>\n<input autocomplete=\"current-password\" data-kid=\"1-2-2-1-8-2-2\" data-name=\"password input field\" id=\"a-password\" name=\"password\" placeholder=\"Enter your password\" type=\"password\"/>\n<button aria-label=\"Show password\" class=\"ptoggle\" data-kid=\"1-2-2-1-8-2-3\" data-name=\"toggle password visibility button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-eye\" data-kid=\"1-2-2-1-8-2-3-1\" data-name=\"eye icon on password toggle\"></i></button>\n</div>\n</div>\n<label class=\"check\" data-kid=\"1-2-2-1-9\" data-name=\"remember me checkbox\">\n<input checked=\"\" data-kid=\"1-2-2-1-9-1\" data-name=\"remember me hidden checkbox input\" type=\"checkbox\"/>\n<span class=\"box\" data-kid=\"1-2-2-1-9-2\" data-name=\"remember me visual checkbox box\"><i aria-hidden=\"true\" class=\"icon-check\" data-kid=\"1-2-2-1-9-2-1\" data-name=\"checkmark icon inside checkbox\"></i></span>\n          Remember me on this device\n        </label>\n<button class=\"submit\" data-kid=\"1-2-2-1-10\" data-name=\"primary sign in submit button\" type=\"submit\">Sign in</button>\n<p class=\"switch\" data-kid=\"1-2-2-1-11\" data-name=\"sign up switch message\">New to ScamShield AI? <a data-kid=\"1-2-2-1-11-1\" data-name=\"create an account link\" href=\"#\">Create an account</a></p>\n</div>\n</div>\n</section>\n<footer class=\"page-foot\" data-kid=\"1-3\" data-name=\"page footer bar\">\n<span class=\"foot-brand\" data-kid=\"1-3-1\" data-name=\"small footer brand mark\"><img alt=\"\" data-kid=\"1-3-1-1\" data-name=\"small brand shield logo image\" height=\"14\" src=\"/api/local/images/ScamShield-AI/frontend/public/shield.svg\" width=\"14\"/>ScamShield AI</span>\n<nav data-kid=\"1-3-2\" data-name=\"footer navigation links\"><a data-kid=\"1-3-2-1\" data-name=\"privacy policy footer link\" href=\"#\">Privacy Policy</a><a data-kid=\"1-3-2-2\" data-name=\"terms footer link\" href=\"#\">Terms</a></nav>\n<span data-kid=\"1-3-3\" data-name=\"session expiry notice text\">Sessions expire after 1 hour</span>\n</footer>\n</main>",
      "comments": [],
      "created": "2026-11-13T19:03:28.869644+00:00",
