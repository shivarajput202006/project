      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n*, *::before, *::after { box-sizing: border-box; }\nbody { margin: 0; }\n\n.sheet {\n  min-height: 100vh; padding: 34px 44px 40px; font-family: \"DM Sans\", sans-serif; color: #f8fafc;\n  background:\n    radial-gradient(ellipse at 10% 0%, rgba(6,182,212,.1), transparent 38%),\n    radial-gradient(ellipse at 90% 100%, rgba(37,99,235,.12), transparent 42%),\n    #080d1b;\n}\n\n.sheet-head { display: flex; align-items: center; justify-content: space-between; gap: 20px; width: min(1120px, 100%); margin: 0 auto 22px; padding-bottom: 16px; border-bottom: 1px solid rgba(148,163,184,.13); }\n.sheet-head .brand { display: inline-flex; align-items: center; gap: 10px; font-family: Manrope, sans-serif; font-size: 15px; font-weight: 800; letter-spacing: -.6px; }\n.sheet-head .brand em { font-style: normal; color: #67d8ed; }\n.sheet-head .brand img { display: block; width: 26px; height: 26px; }\n.sheet-head > span { color: #7b8a9f; font-size: 10.5px; }\n\n.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; width: min(1120px, 100%); margin: 0 auto; }\n\n.panel { margin: 0; display: flex; flex-direction: column; gap: 9px; }\n.step { color: #7f8ea5; font-size: 10.5px; font-weight: 600; letter-spacing: .2px; }\n\n.card {\n  position: relative; flex: 1; border: 1px solid rgba(148,163,184,.17); border-radius: 10px; padding: 24px 23px 21px;\n  background: linear-gradient(158deg, rgba(20,31,52,.93), rgba(10,17,31,.97));\n  box-shadow: inset 0 1px 0 rgba(255,255,255,.05), inset 0 -1px 0 rgba(0,0,0,.45), 0 0 0 1px rgba(6,182,212,.05), 0 26px 70px rgba(0,0,0,.38);\n  backdrop-filter: blur(18px);\n}\n.card::before { content: \"\"; position: absolute; inset: 0 0 auto; height: 7px; border-radius: 10px 10px 0 0; opacity: .5;\n  background-image: repeating-linear-gradient(90deg, rgba(148,163,184,.35) 0 1px, transparent 1px 9px); }\n\n.card h2 { margin: 8px 0 6px; font-family: Manrope, sans-serif; font-size: 20px; font-weight: 800; letter-spacing: -.7px; line-height: 1.24; }\n.card-lede { margin: 0 0 16px; color: #93a2b7; font-size: 11.5px; line-height: 1.7; }\n.rule { position: relative; height: 1px; margin-bottom: 16px; background: rgba(148,163,184,.13); }\n.rule span { position: absolute; left: 0; top: 0; width: 42px; height: 1px; background: linear-gradient(90deg, #22d3ee, transparent); }\n\n.field { margin-top: 12px; }\n.f-label { display: block; margin-bottom: 6px; color: #d5dfeb; font-size: 10.5px; font-weight: 600; }\n.f-row { display: flex; align-items: center; justify-content: space-between; margin: 13px 0 6px; }\n.f-row .f-label { margin: 0; }\n\n.well { display: flex; align-items: center; gap: 9px; min-height: 42px; padding: 0 11px; border-radius: 6px;\n  border: 1px solid rgba(148,163,184,.17); background: rgba(4,9,19,.72); color: #6b7b91;\n  box-shadow: inset 0 2px 6px rgba(0,0,0,.5), inset 0 -1px 0 rgba(255,255,255,.03);\n  transition: border-color .2s ease, box-shadow .2s ease, color .2s ease;\n}\n.well:focus-within { border-color: rgba(6,182,212,.6); color: #8fe3f0; box-shadow: inset 0 2px 6px rgba(0,0,0,.5), 0 0 0 3px rgba(6,182,212,.08); }\n.well.is-error { border-color: rgba(248,113,113,.7); }\n.well i { font-size: 14px; }\n.well input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; color: #f1f5f9; font-family: inherit; font-size: 11.5px; }\n.well input::placeholder { color: #5c6b82; }\n.ptoggle { display: grid; place-items: center; border: 0; padding: 3px; background: none; color: #7e8da3; font-size: 14px; cursor: pointer; }\n\n.strength { display: flex; align-items: center; gap: 8px; margin-top: 7px; color: #8b9ab0; font-size: 9px; }\n.bars { display: flex; flex: 1; gap: 3px; }\n.bars span { flex: 1; height: 3px; border-radius: 2px; background: rgba(148,163,184,.2); }\n.bars span.on { background: #34d399; }\n\n.check { display: inline-flex; align-items: flex-start; gap: 8px; margin-top: 14px; color: #9dabbe; font-size: 10px; line-height: 1.6; cursor: pointer; }\n.check input { position: absolute; opacity: 0; pointer-events: none; }\n.check .box { display: grid; place-items: center; flex: 0 0 auto; width: 13px; height: 13px; margin-top: 1px; border-radius: 3px; border: 1px solid rgba(148,163,184,.36); background: rgba(4,9,19,.7); color: transparent; font-size: 8px; }\n.check input:checked + .box { border-color: rgba(6,182,212,.75); background: rgba(6,182,212,.2); color: #a5f3fc; }\n.check a { color: #6bcfe0; text-decoration: underline; text-underline-offset: 2px; }\n\n.submit { display: flex; align-items: center; justify-content: center; gap: 9px; width: 100%; min-height: 43px; margin-top: 16px;\n  border: 1px solid rgba(96,165,250,.5); border-radius: 6px; background: #2563eb; color: #fff;\n  font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer;\n  box-shadow: 0 8px 24px rgba(37,99,235,.3), inset 0 1px 0 rgba(255,255,255,.2);\n}\n.submit.is-loading { background: #1d4ed8; cursor: wait; }\n.submit i { font-size: 14px; }\n.submit .spin { animation: spin .9s linear infinite; }\n@keyframes spin { to { transform: rotate(360deg); } }\n\n.ghost { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; min-height: 41px; margin-top: 9px;\n  border: 1px solid rgba(148,163,184,.2); border-radius: 6px; background: rgba(255,255,255,.02); color: #ccd8e6;\n  font-family: inherit; font-size: 11.5px; font-weight: 600; cursor: pointer; text-decoration: none;\n}\n.ghost:hover { border-color: rgba(6,182,212,.4); }\n.ghost i { font-size: 14px; }\n\n.provider { display: flex; align-items: center; gap: 11px; width: 100%; min-height: 44px; margin-bottom: 7px; padding: 0 13px;\n  border: 1px solid rgba(148,163,184,.16); border-radius: 4px 10px 4px 4px; background: rgba(255,255,255,.018);\n  color: #e7edf6; font-family: inherit; font-size: 12px; font-weight: 600; text-align: left;\n}\n.provider.is-busy { opacity: .45; }\n.provider .mark { display: grid; place-items: center; width: 20px; height: 20px; }\n.provider .mark svg { width: 15px; height: 15px; display: block; }\n.provider .kbd { margin-left: auto; color: #64748b; font-size: 9.5px; }\n\n.alert { display: flex; align-items: flex-start; gap: 9px; margin: 0 0 14px; padding: 10px 11px; border-radius: 7px;\n  border: 1px solid rgba(248,113,113,.28); background: rgba(127,29,29,.2); color: #fecaca; font-size: 10.5px; line-height: 1.6; }\n.alert i { flex: 0 0 auto; margin-top: 1px; font-size: 13px; color: #f87171; }\n.alert code { display: inline-block; margin-top: 5px; padding: 1px 5px; border-radius: 3px; background: rgba(0,0,0,.32); color: #fca5a5; font-size: 9.5px; }\n\n.provider-tile { position: relative; display: grid; place-items: center; width: 42px; height: 42px; margin-bottom: 15px; border-radius: 11px;\n  border: 1px solid rgba(248,113,113,.35); background: rgba(248,113,113,.08); }\n.provider-tile svg { width: 21px; height: 21px; display: block; }\n.provider-tile .badge { position: absolute; right: -5px; bottom: -5px; display: grid; place-items: center; width: 17px; height: 17px; border-radius: 50%;\n  background: #7f1d1d; border: 1px solid rgba(248,113,113,.5); color: #fecaca; font-size: 9px; }\n\n.note { display: flex; align-items: flex-start; gap: 8px; margin: 13px 0 0; color: #8d9cb1; font-size: 10px; line-height: 1.65; }\n.note i { flex: 0 0 auto; margin-top: 1px; font-size: 12px; color: #4fbfd4; }\n\n.switch { margin: 14px 0 0; text-align: center; color: #93a2b7; font-size: 10.5px; }\n.switch a { color: #6bcfe0; font-weight: 600; text-decoration: none; }\n\n@media (max-width: 940px) {\n  .sheet { padding: 22px 20px 28px; }\n  .grid { grid-template-columns: 1fr; }\n  .sheet-head > span { display: none; }\n}\n</style>\n<div class=\"sheet\" data-kid=\"1\" data-name=\"page layout container\">\n<div class=\"sheet-head\" data-kid=\"1-1\" data-name=\"page header bar\">\n<span class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo label\"><img alt=\"\" data-kid=\"1-1-1-1\" data-name=\"brand shield logo image\" src=\"/api/local/images/ScamShield-AI/frontend/public/shield.svg\"/>ScamShield<em data-kid=\"1-1-1-2\" data-name=\"AI brand accent text\"> AI</em></span>\n</div>\n<div class=\"grid\" data-kid=\"1-2\" data-name=\"panel grid container\">\n<figure class=\"panel\" data-kid=\"1-2-1\" data-name=\"create account panel\">\n<figcaption class=\"step\" data-kid=\"1-2-1-1\" data-name=\"create account step caption\">Create account</figcaption>\n<div class=\"card\" data-kid=\"1-2-1-2\" data-name=\"create account card\">\n<h2 data-kid=\"1-2-1-2-1\" data-name=\"create account card heading\">Create your account</h2>\n<p class=\"card-lede\" data-kid=\"1-2-1-2-2\" data-name=\"create account lede text\">One account for scam detection, resume analysis and job matching.</p>\n<div class=\"rule\" data-kid=\"1-2-1-2-3\" data-name=\"card decorative divider line\"><span data-kid=\"1-2-1-2-3-1\" data-name=\"divider accent glow\"></span></div>\n<div class=\"field\" data-kid=\"1-2-1-2-4\" data-name=\"full name field\" style=\"margin-top:0\">\n<label class=\"f-label\" data-kid=\"1-2-1-2-4-1\" data-name=\"full name field label\" for=\"s-name\">Full name</label>\n<div class=\"well\" data-kid=\"1-2-1-2-4-2\" data-name=\"full name input well\">\n<i aria-hidden=\"true\" class=\"icon-user\" data-kid=\"1-2-1-2-4-2-1\" data-name=\"user profile icon\"></i>\n<input autocomplete=\"name\" data-kid=\"1-2-1-2-4-2-2\" data-name=\"full name text input field\" id=\"s-name\" name=\"fullName\" placeholder=\"Priya Raman\" type=\"text\"/>\n</div>\n</div>\n<div class=\"field\" data-kid=\"1-2-1-2-5\" data-name=\"email field\">\n<label class=\"f-label\" data-kid=\"1-2-1-2-5-1\" data-name=\"email field label\" for=\"s-email\">Email address</label>\n<div class=\"well\" data-kid=\"1-2-1-2-5-2\" data-name=\"email input well\">\n<i aria-hidden=\"true\" class=\"icon-mail\" data-kid=\"1-2-1-2-5-2-1\" data-name=\"envelope email icon\"></i>\n<input autocomplete=\"email\" data-kid=\"1-2-1-2-5-2-2\" data-name=\"email address text input field\" id=\"s-email\" name=\"email\" placeholder=\"you@example.com\" type=\"email\"/>\n</div>\n</div>\n<div class=\"field\" data-kid=\"1-2-1-2-6\" data-name=\"password field\">\n<label class=\"f-label\" data-kid=\"1-2-1-2-6-1\" data-name=\"password field label\" for=\"s-password\">Password</label>\n<div class=\"well\" data-kid=\"1-2-1-2-6-2\" data-name=\"password input well\">\n<i aria-hidden=\"true\" class=\"icon-lock-keyhole\" data-kid=\"1-2-1-2-6-2-1\" data-name=\"lock icon\"></i>\n<input autocomplete=\"new-password\" data-kid=\"1-2-1-2-6-2-2\" data-name=\"password input field\" id=\"s-password\" name=\"password\" type=\"password\" value=\"Recruiter-2026!\"/>\n<button aria-label=\"Show password\" class=\"ptoggle\" data-kid=\"1-2-1-2-6-2-3\" data-name=\"show password toggle button\" type=\"button\"><i aria-hidden=\"true\" class=\"icon-eye\" data-kid=\"1-2-1-2-6-2-3-1\" data-name=\"eye icon\"></i></button>\n</div>\n<div class=\"strength\" data-kid=\"1-2-1-2-6-3\" data-name=\"password strength indicator row\">\n<div class=\"bars\" data-kid=\"1-2-1-2-6-3-1\" data-name=\"password strength bar track\"><span class=\"on\" data-kid=\"1-2-1-2-6-3-1-1\" data-name=\"strength bar segment\"></span><span class=\"on\" data-kid=\"1-2-1-2-6-3-1-2\" data-name=\"strength bar segment\"></span><span class=\"on\" data-kid=\"1-2-1-2-6-3-1-3\" data-name=\"strength bar segment\"></span><span class=\"on\" data-kid=\"1-2-1-2-6-3-1-4\" data-name=\"strength bar segment\"></span></div>\n            Strong\n          </div>\n</div>\n<div class=\"field\" data-kid=\"1-2-1-2-7\" data-name=\"confirm password field\">\n<label class=\"f-label\" data-kid=\"1-2-1-2-7-1\" data-name=\"confirm password field label\" for=\"s-confirm\">Confirm password</label>\n<div class=\"well\" data-kid=\"1-2-1-2-7-2\" data-name=\"confirm password input well\">\n<i aria-hidden=\"true\" class=\"icon-lock-keyhole\" data-kid=\"1-2-1-2-7-2-1\" data-name=\"lock icon\"></i>\n<input autocomplete=\"new-password\" data-kid=\"1-2-1-2-7-2-2\" data-name=\"confirm password input field\" id=\"s-confirm\" name=\"confirmPassword\" type=\"password\" value=\"Recruiter-2026!\"/>\n</div>\n</div>\n<label class=\"check\" data-kid=\"1-2-1-2-8\" data-name=\"t&amp;c checkbox label wrapper\">\n<input checked=\"\" data-kid=\"1-2-1-2-8-1\" data-name=\"t&amp;c checkbox input\" type=\"checkbox\"/>\n<span class=\"box\" data-kid=\"1-2-1-2-8-2\" data-name=\"checkbox visual box\"><i aria-hidden=\"true\" class=\"icon-check\" data-kid=\"1-2-1-2-8-2-1\" data-name=\"checkmark icon\"></i></span>\n<span data-kid=\"1-2-1-2-8-3\" data-name=\"t&amp;c acceptance text\">I accept the <a data-kid=\"1-2-1-2-8-3-1\" data-name=\"terms link\" href=\"#\">Terms</a> and <a data-kid=\"1-2-1-2-8-3-2\" data-name=\"privacy policy link\" href=\"#\">Privacy Policy</a>.</span>\n</label>\n<button class=\"submit\" data-kid=\"1-2-1-2-9\" data-name=\"create account submit button\" type=\"submit\">Create account</button>\n<p class=\"switch\" data-kid=\"1-2-1-2-10\" data-name=\"switch to sign in prompt\">Already have an account? <a data-kid=\"1-2-1-2-10-1\" data-name=\"sign in link\" href=\"#\">Sign in</a></p>\n</div>\n</figure>\n<figure class=\"panel\" data-kid=\"1-2-2\" data-name=\"sign in panel\">\n<figcaption class=\"step\" data-kid=\"1-2-2-1\" data-name=\"sign in step caption\">Signing in</figcaption>\n<div class=\"card\" data-kid=\"1-2-2-2\" data-name=\"sign in card\">\n<h2 data-kid=\"1-2-2-2-1\" data-name=\"sign in card heading\">Sign in to ScamShield AI</h2>\n<p class=\"card-lede\" data-kid=\"1-2-2-2-2\" data-name=\"sign in lede text\">Access your scan history, reports and saved jobs.</p>\n<div class=\"rule\" data-kid=\"1-2-2-2-3\" data-name=\"card decorative divider line\"><span data-kid=\"1-2-2-2-3-1\" data-name=\"divider accent glow\"></span></div>\n<button class=\"provider is-busy\" data-kid=\"1-2-2-2-4\" data-name=\"continue with GitHub button\" disabled=\"\" type=\"button\">\n<span class=\"mark\" data-kid=\"1-2-2-2-4-1\" data-name=\"GitHub mark container\"><svg aria-hidden=\"true\" data-kid=\"1-2-2-2-4-1-1\" data-name=\"GitHub logo icon\" viewbox=\"0 0 24 24\"><path d=\"M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12\" fill=\"#e8eef8\"></path></svg></span>\n          Continue with GitHub\n        </button>\n<button class=\"provider is-busy\" data-kid=\"1-2-2-2-5\" data-name=\"continue with LinkedIn button\" disabled=\"\" type=\"button\">\n<span class=\"mark\" data-kid=\"1-2-2-2-5-1\" data-name=\"LinkedIn mark container\"><svg aria-hidden=\"true\" data-kid=\"1-2-2-2-5-1-1\" data-name=\"LinkedIn logo icon\" viewbox=\"0 0 24 24\"><path d=\"M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z\" fill=\"#5aa9ef\"></path></svg></span>\n          Continue with LinkedIn\n        </button>\n<div class=\"field\" data-kid=\"1-2-2-2-6\" data-name=\"sign in email field\" style=\"margin-top:14px\">\n<label class=\"f-label\" data-kid=\"1-2-2-2-6-1\" data-name=\"sign in email field label\" for=\"s2-email\">Email address</label>\n<div class=\"well\" data-kid=\"1-2-2-2-6-2\" data-name=\"sign in email input well\">\n<i aria-hidden=\"true\" class=\"icon-mail\" data-kid=\"1-2-2-2-6-2-1\" data-name=\"envelope email icon\"></i>\n<input data-kid=\"1-2-2-2-6-2-2\" data-name=\"readonly sign in email input\" id=\"s2-email\" readonly=\"\" type=\"email\" value=\"priya.raman@example.com\"/>\n</div>\n</div>\n<div class=\"field\" data-kid=\"1-2-2-2-7\" data-name=\"sign in password field\">\n<div class=\"f-row\" data-kid=\"1-2-2-2-7-1\" data-name=\"sign in password label row\">\n<label class=\"f-label\" data-kid=\"1-2-2-2-7-1-1\" data-name=\"sign in password label\" for=\"s2-password\">Password</label>\n<a class=\"f-link\" data-kid=\"1-2-2-2-7-1-2\" data-name=\"forgot password link\" href=\"#\" style=\"color:#6bcfe0;font-size:10px;font-weight:600;text-decoration:none\">Forgot password?</a>\n</div>\n<div class=\"well\" data-kid=\"1-2-2-2-7-2\" data-name=\"sign in password input well\">\n<i aria-hidden=\"true\" class=\"icon-lock-keyhole\" data-kid=\"1-2-2-2-7-2-1\" data-name=\"lock icon\"></i>\n<input data-kid=\"1-2-2-2-7-2-2\" data-name=\"readonly sign in password input\" id=\"s2-password\" readonly=\"\" type=\"password\" value=\"Recruiter-2026!\"/>\n</div>\n</div>\n<button class=\"submit is-loading\" data-kid=\"1-2-2-2-8\" data-name=\"signing in loading button\" disabled=\"\" type=\"button\">\n<i aria-hidden=\"true\" class=\"icon-loader-circle spin\" data-kid=\"1-2-2-2-8-1\" data-name=\"spinning loader icon\"></i>\n          Signing in…\n        </button>\n<p class=\"note\" data-kid=\"1-2-2-2-9\" data-name=\"password security note\"><i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-2-2-2-9-1\" data-name=\"shield check icon\"></i>Your password is sent over the session and never stored in this browser.</p>\n</div>\n</figure>\n<figure class=\"panel\" data-kid=\"1-2-3\" data-name=\"session expired panel\">\n<figcaption class=\"step\" data-kid=\"1-2-3-1\" data-name=\"session expired step caption\">Session expired</figcaption>\n<div class=\"card\" data-kid=\"1-2-3-2\" data-name=\"session expired card\">\n<h2 data-kid=\"1-2-3-2-1\" data-name=\"session expired card heading\">Your session ended</h2>\n<p class=\"card-lede\" data-kid=\"1-2-3-2-2\" data-name=\"session expired lede text\">Sessions last one hour. Sign in again to return to where you were.</p>\n<div class=\"rule\" data-kid=\"1-2-3-2-3\" data-name=\"card decorative divider line\"><span data-kid=\"1-2-3-2-3-1\" data-name=\"divider accent glow\"></span></div>\n<div class=\"field\" data-kid=\"1-2-3-2-4\" data-name=\"session expired email field\" style=\"margin-top:0\">\n<label class=\"f-label\" data-kid=\"1-2-3-2-4-1\" data-name=\"session expired email label\" for=\"s3-email\">Email address</label>\n<div class=\"well\" data-kid=\"1-2-3-2-4-2\" data-name=\"session expired email input well\">\n<i aria-hidden=\"true\" class=\"icon-mail\" data-kid=\"1-2-3-2-4-2-1\" data-name=\"envelope email icon\"></i>\n<input data-kid=\"1-2-3-2-4-2-2\" data-name=\"readonly session email input\" id=\"s3-email\" readonly=\"\" type=\"email\" value=\"priya.raman@example.com\"/>\n</div>\n</div>\n<div class=\"field\" data-kid=\"1-2-3-2-5\" data-name=\"session expired password field\">\n<label class=\"f-label\" data-kid=\"1-2-3-2-5-1\" data-name=\"session expired password label\" for=\"s3-password\">Password</label>\n<div class=\"well\" data-kid=\"1-2-3-2-5-2\" data-name=\"session expired password input well\">\n<i aria-hidden=\"true\" class=\"icon-lock-keyhole\" data-kid=\"1-2-3-2-5-2-1\" data-name=\"lock icon\"></i>\n<input data-kid=\"1-2-3-2-5-2-2\" data-name=\"session password input field\" id=\"s3-password\"