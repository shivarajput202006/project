# Copy this file to .env in this folder and replace both placeholder values.
# MongoDB Atlas: use your own SRV URI and percent-encode special password characters.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/scamshield_db?retryWrites=true&w=majority

# Generate a random secret and base64-encode at least 32 bytes.
# Example PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET_BASE64=REPLACE_WITH_A_RANDOM_BASE64_SECRET_OF_AT_LEAST_32_BYTES

# Set true when serving over HTTPS in production; keep false for local HTTP development.
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173

# Optional for local startup; analysis requests return 503 until a valid Gemini API key is configured.
# Create a key in Google AI Studio and keep the real value only in backend/.env or the deployment secret store.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=20s

# Resume uploads are private in MongoDB GridFS. Configure limits if needed.
RESUME_MAX_FILE_SIZE=5MB
RESUME_MAX_REQUEST_SIZE=6MB

# Optional. If configured, submitted URLs are sent to this fixed Google Safe Browsing endpoint.
# Keep the key only in this backend environment file or deployment secret store.
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional. Register for an Adzuna API key at https://developer.adzuna.com/signup.
# Configure only after confirming your intended use is permitted by Adzuna's current terms/license.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# Optional tuning for Module 08. The five non-negative weights must total exactly 100.
JOB_MATCH_WEIGHT_SKILLS=50
JOB_MATCH_WEIGHT_EXPERIENCE=20
JOB_MATCH_WEIGHT_EDUCATION=10
JOB_MATCH_WEIGHT_LOCATION_MODE=10
JOB_MATCH_WEIGHT_JOB_TYPE=10
